# ============================================================
# TRAFFIC AI - ENVIRONMENT CONFIGURATION
# ============================================================

# Frontend Host Port (Default: 80)
# Change to another port (e.g., 8080) if port 80 is occupied on the host machine.
PORT=80

# ============================================================
# AWS CREDENTIALS & S3 CONFIGURATION
# ============================================================
# NOTE:
# 1. On AWS EC2 instances with an IAM Role attached, leave
#    AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY blank.
#    Boto3 will automatically use the IAM instance profile.
#
# 2. When running on another computer, local PC, or non-EC2 server,
#    provide your AWS IAM User access credentials below:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS Region where your S3 bucket resides
AWS_DEFAULT_REGION=ap-south-1

# Target S3 Bucket name
AWS_S3_BUCKET=traffic-ai-buck

# Folder prefix inside S3 bucket
AWS_S3_PREFIX=uploads
